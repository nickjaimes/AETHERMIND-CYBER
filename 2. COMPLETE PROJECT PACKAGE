# Push Docker images to registry
push_docker_images() {
    log_info "Pushing Docker images to registry..."
    
    # Login to Docker registry (example with ECR)
    aws ecr get-login-password --region ${REGION} | \
        docker login --username AWS --password-stdin \
        123456789012.dkr.ecr.${REGION}.amazonaws.com
    
    # Create ECR repositories if they don't exist
    for image in quantum biological fusion threat response forensics api monitoring; do
        if ! aws ecr describe-repositories --repository-name aethermind/cyber-${image} --region ${REGION} 2>/dev/null; then
            aws ecr create-repository \
                --repository-name aethermind/cyber-${image} \
                --region ${REGION} \
                --image-scanning-configuration scanOnPush=true \
                --image-tag-mutability MUTABLE
            log_success "Created ECR repository for ${image}"
        fi
    done
    
    # Tag and push images
    for image in quantum biological fusion threat response forensics api monitoring; do
        log_info "Pushing ${image} image..."
        
        # Tag for ECR
        docker tag aethermind/cyber-${image}:2.0.0 \
            123456789012.dkr.ecr.${REGION}.amazonaws.com/aethermind/cyber-${image}:2.0.0
        
        docker tag aethermind/cyber-${image}:latest \
            123456789012.dkr.ecr.${REGION}.amazonaws.com/aethermind/cyber-${image}:latest
        
        # Push images
        docker push 123456789012.dkr.ecr.${REGION}.amazonaws.com/aethermind/cyber-${image}:2.0.0
        docker push 123456789012.dkr.ecr.${REGION}.amazonaws.com/aethermind/cyber-${image}:latest
        
        log_success "Pushed ${image} image to ECR"
    done
}

# Deploy infrastructure with Terraform
deploy_infrastructure() {
    log_info "Deploying infrastructure with Terraform..."
    
    cd deployment/TERRAFORM
    
    # Initialize Terraform
    terraform init -backend-config="environment/${ENVIRONMENT}/backend.tfvars"
    
    # Validate Terraform configuration
    terraform validate
    
    # Plan deployment
    terraform plan \
        -var-file="environment/${ENVIRONMENT}/terraform.tfvars" \
        -out="terraform.plan"
    
    # Apply deployment
    terraform apply "terraform.plan"
    
    # Get outputs
    terraform output -json > ../../configs/terraform_output.json
    
    cd ../..
    
    log_success "Infrastructure deployed successfully"
}

# Setup Kubernetes
setup_kubernetes() {
    log_info "Setting up Kubernetes..."
    
    # Configure kubectl for EKS
    aws eks update-kubeconfig \
        --region ${REGION} \
        --name ${CLUSTER_NAME}
    
    # Create namespace
    kubectl create namespace ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
    
    # Create service accounts
    kubectl apply -f deployment/KUBERNETES/manifests/service-accounts.yaml -n ${NAMESPACE}
    
    # Create roles and bindings
    kubectl apply -f deployment/KUBERNETES/manifests/rbac.yaml -n ${NAMESPACE}
    
    # Create config maps
    kubectl apply -f deployment/KUBERNETES/manifests/configmaps.yaml -n ${NAMESPACE}
    
    # Create secrets
    kubectl create secret generic db-secret \
        --from-file=password=./secrets/db_password.txt \
        -n ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
    
    kubectl create secret generic redis-secret \
        --from-file=password=./secrets/redis_password.txt \
        -n ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
    
    kubectl create secret generic rabbitmq-secret \
        --from-file=password=./secrets/rabbitmq_password.txt \
        -n ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
    
    kubectl create secret generic api-secret \
        --from-file=key=./secrets/api_key.txt \
        -n ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
    
    kubectl create secret generic quantum-secret \
        --from-file=key=./secrets/quantum_key.txt \
        -n ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
    
    log_success "Kubernetes setup completed"
}

