class TemporalTransformerLayer(nn.Module):
    """Transformer layer with temporal awareness"""
    
    def __init__(self, embed_dim, num_heads, quantum_dim):
        super().__init__()
        
        self.temporal_attention = TemporalAttention(
            embed_dim, num_heads, quantum_dim
        )
        self.quantum_feedforward = QuantumFeedForward(embed_dim, quantum_dim)
        self.norm1 = nn.LayerNorm(embed_dim)
        self.norm2 = nn.LayerNorm(embed_dim)
        self.dropout = nn.Dropout(0.1)
    
    def forward(self, x, mask=None, temporal_context=None):
        # Temporal attention
        attn_out, temporal_feat = self.temporal_attention(
            x, x, x, mask=mask, temporal_context=temporal_context
        )
        x = self.norm1(x + self.dropout(attn_out))
        
        # Quantum feedforward
        ff_out = self.quantum_feedforward(x)
        x = self.norm2(x + self.dropout(ff_out))
        
        return x, temporal_feat

class SpacetimeFusionLayer(nn.Module):
    """Fuse spatial and temporal features"""
    
    def __init__(self, embed_dim, quantum_dim):
        super().__init__()
        
        self.spatial_proj = nn.Linear(embed_dim, quantum_dim)
        self.temporal_proj = nn.Linear(embed_dim, quantum_dim)
        self.fusion_gate = nn.Sequential(
            nn.Linear(quantum_dim * 2, quantum_dim),
            nn.Sigmoid()
        )
        self.output_proj = nn.Linear(quantum_dim, embed_dim)
    
    def forward(self, spatial_features, temporal_features):
        # Project to common space
        spatial_proj = self.spatial_proj(spatial_features)
        temporal_proj = self.temporal_proj(torch.stack(temporal_features).mean(0))
        
        # Dynamic fusion gate
        combined = torch.cat([spatial_proj, temporal_proj], dim=-1)
        gate = self.fusion_gate(combined)
        
        # Gated fusion
        fused = gate * spatial_proj + (1 - gate) * temporal_proj
        
        return self.output_proj(fused)

