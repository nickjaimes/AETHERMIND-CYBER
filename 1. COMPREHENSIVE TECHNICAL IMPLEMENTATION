        """Convert bit list to bytes"""
        byte_array = bytearray()
        for i in range(0, len(bits), 8):
            byte = 0
            for j in range(8):
                if i + j < len(bits):
                    byte |= bits[i + j] << (7 - j)
            byte_array.append(byte)
        return bytes(byte_array)

class QuantumMemory:
    """Quantum memory with error correction"""
    
    def __init__(self, logical_qubits: int = 12):
        self.logical_qubits = logical_qubits
        self.physical_qubits = 4 * logical_qubits  # Surface code overhead
        self.memory_time = 1.0  # seconds
        self.error_rate = 1e-4
        
    def store_state(self, quantum_state, t1: float, t2: float):
        """Store quantum state with error correction"""
        # Apply surface code error correction
        encoded_state = self._surface_code_encode(quantum_state)
        
        # Calculate storage fidelity
        fidelity = np.exp(-self.memory_time * (1/t1 + 1/t2))
        fidelity *= (1 - self.error_rate) ** self.physical_qubits
        
        return {
            'encoded_state': encoded_state,
            'fidelity': fidelity,
            'logical_qubits': self.logical_qubits,
            'physical_qubits': self.physical_qubits
        }
    
    def _surface_code_encode(self, state):
        """Surface code quantum error correction"""
        # Implement surface code encoding
        d = int(np.sqrt(self.physical_qubits))  # Code distance
        # Simplified representation
        return {'encoded': True, 'distance': d, 'state': state}
