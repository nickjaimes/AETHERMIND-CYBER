            qc.measure(0, 0)
            
            # Execute
            job = await self.simulator.run(qc, shots=1)
            result = job.result()
            bit = int(list(result.get_counts().keys())[0])
            transmitted_bits.append(bit)
        
        # Sift key (keep bits where bases match)
        sifted_key = []
        for i in range(length):
            if alice_bases[i] == bob_bases[i]:
                sifted_key.append(transmitted_bits[i])
                
